{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml"
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".git/",
      "test-clone/",
      "*-clone/",
      "*.bundle",
      "*UNSAFE-DO-NOT-SHARE*",
      "repomix-output.*",
      "hypertaks-agent.xml",
      "hypertaks-agent.txt",
      "hypertaks.xml",
      ".tmp-probe/",
      ".hypertaks-runtime/",
      "__pycache__/",
      "*.py[cod]"
    ]
  }
}
