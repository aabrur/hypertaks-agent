{
  "name": "hypertaks",
  "version": "0.0.4.5.9",
  "description": "Hypertaks Founder Operating System with secure founder continuity, evidence-backed memory, Graphify routing, and cross-agent handoff.",
  "license": "MIT",
  "author": "abrur <abrur_nic@yahoo.com>",
  "homepage": "https://github.com/aabrur/hypertaks-agent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aabrur/hypertaks-agent.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "chatgpt",
    "plugin",
    "skill",
    "founder",
    "multi-agent",
    "continuity",
    "memory",
    "graphify",
    "obsidian",
    "mcp"
  ],
  "files": [
    "skills/",
    "runtime/",
    "assets/",
    "distribution/",
    "plugins/",
    "plugin.yaml",
    "__init__.py",
    "scripts/build_distributions.py",
    "scripts/validate_distributions.py",
    "scripts/validate_coding_agents.py",
    "scripts/validate_managed_agents.py",
    "scripts/validate_chat_selfhosted_agents.py",
    "scripts/validate_plugin_compatibility.py",
    "scripts/validate_marketplace_readiness.py",
    ".plugin/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    ".kimi-plugin/",
    ".openclaw/",
    ".hermes/",
    ".opencode/",
    ".pi/",
    ".agents/",
    ".aider/",
    ".chatgpt/",
    ".claude-ai/",
    ".cline/",
    ".gemini-app/",
    ".github-copilot/",
    ".goose/",
    ".kilo/",
    ".librechat/",
    ".open-webui/",
    ".openhands/",
    ".roo/",
    ".windsurf/",
    "README.md",
    "LICENSE"
  ],
  "cline": {
    "plugins": [
      {
        "paths": [
          "./plugins/cline/hypertaks.ts"
        ],
        "capabilities": [
          "rules",
          "commands"
        ]
      }
    ]
  },
  "pi": {
    "extensions": [
      ".pi/extensions/hypertaks.ts"
    ],
    "skills": [
      "skills/"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:runtime": "tsc -p tsconfig.json",
    "test:poc": "node runtime/poc.test.cjs .build/runtime/router.js",
    "test:runtime": "node runtime/router.test.cjs .build/runtime/router.js && node runtime/poc.test.cjs .build/runtime/router.js",
    "check:version-sync": "python scripts/validate_version_sync.py",
    "check:distribution": "python scripts/validate_version_sync.py && python scripts/validate_distributions.py && python scripts/validate_coding_agents.py && python scripts/validate_managed_agents.py && python scripts/validate_chat_selfhosted_agents.py && python scripts/validate_plugin_compatibility.py && python scripts/validate_marketplace_readiness.py && python scripts/build_distributions.py antigravity --check-only && python scripts/build_distributions.py openai --check-only",
    "build:distribution": "python scripts/build_distributions.py antigravity",
    "build:openai": "python scripts/build_distributions.py openai",
    "test:coding-hosts": "python scripts/validate_coding_agents.py && python -m unittest scripts.test_validate_coding_agents -v",
    "test:managed-hosts": "python scripts/validate_managed_agents.py && python -m unittest scripts.test_validate_managed_agents -v",
    "test:chat-hosts": "python scripts/validate_chat_selfhosted_agents.py && python -m unittest scripts.test_validate_chat_selfhosted_agents -v",
    "test:plugin-compatibility": "python scripts/validate_plugin_compatibility.py && python -m unittest scripts.test_validate_plugin_compatibility -v",
    "test:marketplace-readiness": "python scripts/validate_marketplace_readiness.py && python -m unittest scripts.test_validate_marketplace_readiness -v",
    "test": "npm run typecheck && npm run build:runtime && npm run test:runtime && npm run test:mcp && npm run check:version-sync && npm run test:coding-hosts && npm run test:managed-hosts && npm run test:chat-hosts && npm run test:plugin-compatibility && npm run test:marketplace-readiness",
    "prestart:mcp": "tsc -p tsconfig.json",
    "start:mcp": "node runtime/mcp-server.mjs",
    "pretest:mcp": "tsc -p tsconfig.json",
    "test:mcp": "node --test runtime/mcp-server.test.cjs",
    "test:stress": "node --test runtime/stress.test.cjs",
    "test:security": "node --test runtime/security.test.cjs .build/runtime/router.js",
    "test:skill-integrity": "node --test runtime/skill-integrity.test.cjs",
    "test:edge": "node --test runtime/router-edge.test.cjs .build/runtime/router.js",
    "benchmark": "node runtime/benchmark.cjs",
    "cli": "node .build/runtime/cli.js",
    "test:v2": "node --test runtime/version-v2.test.cjs runtime/repo-identity.test.cjs runtime/repo-bootstrap-v2.test.cjs runtime/repository-intelligence.test.cjs runtime/graph-index.test.cjs runtime/graph-incremental.test.cjs runtime/graph-impact.test.cjs runtime/orchestrator-v2.test.cjs runtime/orchestrator-resume.test.cjs runtime/agency-agents-provider.test.cjs runtime/provider-registry.test.cjs runtime/security-v2.test.cjs runtime/evals-v2.test.cjs runtime/lifecycle.test.cjs",
    "test:all": "npm run test && npm run test:v2 && npm run test:stress && npm run test:security && npm run test:skill-integrity && npm run test:edge"
  },
  "peerDependencies": {
    "@cline/sdk": "*",
    "@kilocode/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    },
    "@kilocode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
