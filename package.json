    "graphify",
    "obsidian",
    "retrieval",
    "rag",
    "typescript",
    "mcp"
  ],
  "files": [
    "skills/",
    "runtime/",
    "assets/",
    "distribution/",
    "scripts/build_distributions.py",
    "scripts/validate_distributions.py",
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    ".kimi-plugin/",
    ".openclaw/",
    ".hermes/",
    ".opencode/",
    ".pi/",
    ".agents/",
    ".aider/",
    ".chatgpt/",
    ".claude-ai/",
    ".cline/",
    ".gemini-app/",
    ".github-copilot/",
