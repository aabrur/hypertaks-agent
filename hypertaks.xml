      .join('; ') || 'matrix failures',
  );
  assert.ok(unitReport.total >= 60, `expected broad matrix, got ${unitReport.total}`);

  const detReport = matrix.runDeterminismSuite(
    (request) => router.diagnosePublicSkillRoute(request),
