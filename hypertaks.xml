# 8. Duplicate section headers in the knowledge base.
kb = SKILL_DIR / "references" / "knowledge-base.md"
if kb.exists():
    seen = {}
    for i, line in enumerate(kb.read_text(encoding="utf-8").splitlines(), 1):
        if re.match(r"^#{2,3} ", line):
            header = line.strip()
            if header in seen:
