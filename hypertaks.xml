{
  const repo = makeRepo();
  const activation = router.activateContract({
    contractId: 'HT-POC-J',
    bossMessage: 'APPROVE HT-POC-J',
    isBossTurn: true,
    requiresMutationOrExternalEffect: true,
    projectRoot: repo,
    contractPermissions: AUTHORIZED,
