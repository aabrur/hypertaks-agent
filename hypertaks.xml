            missing = sorted(visual_fields - set(data["contract"]))
            check(not missing,
                  "contract-schema.yaml: missing visual fields: "
                  f"{', '.join(missing)}")
            check("execution_profiles" in data["contract"],
                  "contract-schema.yaml: missing execution_profiles")
