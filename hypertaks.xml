            {
              "description": "Route a founder business diagnosis request to the main Hypertaks skill.",
              "prompt": "Hypertaks, diagnose why churn is high in my SaaS and find the operational bottleneck.",
              "tools_triggered": "hypertaks_route",
              "expected_behavior": "hypertaks_route returns skill hypertaks, nextTool hypertaks_get_skill, and mutationPerformed false. It selects an entry point; it does not diagnose churn or inspect business records. The client may then read the selected skill without executing a workflow."
            },
            {
              "description": "Verify the Hypertaks installation and exact five public skills.",
              "prompt": "Hypertaks, verify the hosted adapter installation and confirm its five public skills.",
              "tools_triggered": "hypertaks_verify_installation",
              "expected_behavior": "hypertaks_verify_installation checks the server deployment, not the user device: exactSkillSet true, publicSkillCount 5, five skill-file SHA-256 hashes, and a logo hash. It cannot inspect the user repository, configure a brain, or repair files."
            },
            {
              "description": "Retrieve one canonical Hypertaks skill by exact name.",
              "prompt": "Hypertaks, load the hypertaks-verify skill so I can see the setup steps.",
              "tools_triggered": "hypertaks_get_skill",
              "expected_behavior": "hypertaks_get_skill with skill hypertaks-verify returns skill, content, path, and a SHA-256 hash. The skill content is included in both text and structured content for compatible clients. No setup steps are executed."
            },
            {
              "description": "Route a founder-shaped request when the user has not named a specific skill.",
              "prompt": "Hypertaks, which Hypertaks skill should handle a checkpoint and proof of done review?",
              "tools_triggered": "hypertaks_route",
              "expected_behavior": "hypertaks_route returns skill hypertaks-continuity, nextTool hypertaks_get_skill, and mutationPerformed false. It does not create a checkpoint or certify completed work. The client may read the selected skill."
            },
            {
              "description": "Route a founder memory request through the supported MCP interface.",
              "prompt": "Hypertaks, how should I record an approved architecture decision in founder memory?",
              "tools_triggered": "hypertaks_route",
              "expected_behavior": "hypertaks_route returns skill hypertaks-brain, nextTool hypertaks_get_skill, and mutationPerformed false. It does not record or approve a decision. The client may read the selected skill."
            }
          ],
          "negative": [
            {
              "description": "Remote deletion is unsupported.",
              "prompt": "Hypertaks, delete my project database through your remote adapter.",
              "expected_behavior": "Explain that the remote adapter exposes no deletion or database-write tool. Do not claim that any record was deleted. Optional route or skill-read calls are allowed but cannot perform the requested effect."
            },
            {
