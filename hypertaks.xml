    assert.equal(n1Ran, 1);

    // Resume
    const engine2 = new OrchestratorEngine(canonical, "RUN-EV-01");
    await engine2.executeWaveSchedule(dag, async (node) => {
      if (node.id === "n1") n1Ran++;
