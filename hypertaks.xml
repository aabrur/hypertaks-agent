import { createHash } from "node:crypto";

export const CONTRACT_ID = "HT-20260811-FOS";

export const ALLOWED_PERMISSIONS = Object.freeze([
  "PERM_EXECUTE",
  "PERM_FILE_WRITE",
  "PERM_READ_LOCAL",
]);

export const FORBIDDEN_EFFECTS = Object.freeze([
  "network",
  "spend",
  "publish",
  "deploy",
  "third_party_communication",
  "delete",
  "onchain",
  "commit",
  "merge",
  "cherry_pick",
