        "EV-63-75 Cline: 13 PASS runtime-gated driver. "
        "EV-76-88 Command Code: 13 PASS runtime-gated. "
        "Rejected prior Antigravity coached/synthetic batches not ledgered."
    ),
    "case_ids": case_ids,
}

doc = {"meta": meta, "results": ordered}
