        with tempfile.TemporaryDirectory() as temp_dir:
            root = Path(temp_dir)
            skills = root / "skills"
            for name in sorted(EXPECTED):
                skill_dir = skills / name
                skill_dir.mkdir(parents=True)
                (skill_dir / "SKILL.md").write_text(
                    f"---\nname: {name}\ndescription: \"Use {name}.\"\n---\n# {name}\n",
