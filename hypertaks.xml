<file path="runtime/repository-intelligence/architecture-compiler.ts">
import * as fs from "node:fs";
import * as path from "node:path";
import { RepositoryScanResult } from "./scanner";
import { RepoIdentity } from "../repo-identity";
import { resolveWithinApprovedRoot } from "../founder-brain";

export function compileArchitecturePack(
  canonicalRoot: string,
  identity: RepoIdentity,
  scanResult: RepositoryScanResult,
): readonly string[] {
  const dotHypertaks = resolveWithinApprovedRoot(canonicalRoot, ".hypertaks", true);
  const archDir = resolveWithinApprovedRoot(canonicalRoot, path.join(".hypertaks", "architecture"), true);
  const diagramsDir = resolveWithinApprovedRoot(canonicalRoot, path.join(".hypertaks", "diagrams"), true);

  const written: string[] = [];
  const now = new Date().toISOString();

  // Extract key summary items
  const totalFiles = scanResult.files.length;
  const totalSymbols = scanResult.parsedFiles.reduce((acc, f) => acc + f.symbols.length, 0);
  const totalRoutes = scanResult.parsedFiles.reduce((acc, f) => acc + f.routes.length, 0);
  const totalTables = scanResult.parsedFiles.reduce((acc, f) => acc + f.tables.length, 0);
  const frameworksStr = scanResult.workspaceInfo.frameworks.join(", ") || "None detected";

  // 1. Root ARCHITECTURE.md
  const archContent = `# Architecture Specification

**Repository:** ${identity.display_name}  
**Repository ID:** \`${identity.repo_id}\`  
**Generated At:** ${now}  
**Status:** EVIDENCE VERIFIED  

## System Context & Technology Stack
- Primary Language: ${scanResult.workspaceInfo.primaryLanguage}
- Package Manager: ${scanResult.workspaceInfo.packageManager}
- Monorepo: ${scanResult.workspaceInfo.isMonorepo ? "Yes" : "No"}
- Frameworks & Libraries: ${frameworksStr}
- Total Scanned Files: ${totalFiles}
- Total Detected Symbols: ${totalSymbols}

## Major Subsystems & Boundaries
- Inbound Routes: ${totalRoutes} endpoints mapped
- Data Schemas: ${totalTables} tables or entity models mapped
- Static Assets: ${scanResult.assets.length} items cataloged

## Primary Data Flows
\`\`\`mermaid
flowchart TD
    Client["Client / User"] --> InboundRoutes["Inbound Routes (${totalRoutes})"]
    InboundRoutes --> BusinessLogic["Application Logic (${totalSymbols} symbols)"]
    BusinessLogic --> Storage["Database / Storage (${totalTables} tables)"]
\`\`\`

## Evidence Sources
All architecture findings derive from physical repository files scanned by Hypertaks RTS.
- Inventories: \`.hypertaks/inventory/\`
- Graph Indexes: \`.hypertaks/graph/\`
`;
  fs.writeFileSync(path.join(dotHypertaks, "ARCHITECTURE.md"), archContent, "utf8");
  written.push(".hypertaks/ARCHITECTURE.md");

  // 2. Root FUNCTION-MAP.md
  const highValueSymbols = scanResult.parsedFiles
    .flatMap((f) =>
      f.symbols
        .filter((s) => s.exported && (s.kind === "function" || s.kind === "component" || s.kind === "class"))
        .map((s) => ({ file: f.filePath, ...s })),
    )
    .slice(0, 100);

  let funcContent = `# Function and Symbol Map

**Repository:** ${identity.display_name}  
**Total Symbols:** ${totalSymbols}  

| Symbol | Kind | File | Line |
|---|---|---|---|
`;
  for (const s of highValueSymbols) {
    funcContent += `| \`${s.name}\` | ${s.kind} | \`${s.file}\` | ${s.line} |\n`;
  }
  if (highValueSymbols.length === 0) {
    funcContent += "| (none detected) | - | - | - |\n";
  }
  fs.writeFileSync(path.join(dotHypertaks, "FUNCTION-MAP.md"), funcContent, "utf8");
  written.push(".hypertaks/FUNCTION-MAP.md");

  // 3. Root DATA-MODEL.md
  const allTables = scanResult.parsedFiles.flatMap((f) =>
    f.tables.map((t) => ({ file: f.filePath, ...t })),
  );
  let dataModelContent = `# Data Model Specification

**Repository:** ${identity.display_name}  
**Total Entities / Tables:** ${totalTables}  

`;
  if (allTables.length > 0) {
    for (const t of allTables) {
      dataModelContent += `### Table: \`${t.tableName}\`\n- File: \`${t.file}:${t.line}\`\n`;
      dataModelContent += `- Columns: ${t.columns.join(", ") || "(none parsed)"}\n`;
      if (t.foreignKeys.length > 0) {
        dataModelContent += `- Relations:\n`;
        for (const fk of t.foreignKeys) {
          dataModelContent += `  - \`${fk.column}\` -> \`${fk.targetTable}(${fk.targetColumn})\`\n`;
        }
      }
      dataModelContent += "\n";
    }
  } else {
    dataModelContent += "No SQL or schema tables were statically detected.\n";
  }
  fs.writeFileSync(path.join(dotHypertaks, "DATA-MODEL.md"), dataModelContent, "utf8");
  written.push(".hypertaks/DATA-MODEL.md");

  // 4. Root NETWORK-DEPENDENCIES.md
  const allRoutes = scanResult.parsedFiles.flatMap((f) =>
    f.routes.map((r) => ({ file: f.filePath, ...r })),
  );
  const allCalls = scanResult.parsedFiles.flatMap((f) =>
    f.networkCalls.map((c) => ({ file: f.filePath, ...c })),
  );

  let netContent = `# Network and External Dependencies

**Repository:** ${identity.display_name}  

## Inbound Endpoints (${allRoutes.length})
| Method | Path | Handler | File |
|---|---|---|---|
`;
  for (const r of allRoutes) {
    netContent += `| \`${r.method}\` | \`${r.path}\` | \`${r.handlerSymbol}\` | \`${r.file}:${r.line}\` |\n`;
  }
  if (allRoutes.length === 0) netContent += "| - | - | - | - |\n";

  netContent += `\n## Outbound Network Calls (${allCalls.length})\n`;
  for (const c of allCalls.slice(0, 50)) {
    netContent += `- \`${c.callee}\` at \`${c.file}:${c.line}\`${c.targetUrlOrEndpoint ? ` -> \`${c.targetUrlOrEndpoint}\`` : ""}\n`;
  }
  fs.writeFileSync(path.join(dotHypertaks, "NETWORK-DEPENDENCIES.md"), netContent, "utf8");
  written.push(".hypertaks/NETWORK-DEPENDENCIES.md");

  // 5. Root ASSET-INDEX.md
  let assetContent = `# Asset Index

**Repository:** ${identity.display_name}  
**Total Assets:** ${scanResult.assets.length}  

| Path | Extension | Size (Bytes) | Hash |
|---|---|---|---|
`;
  for (const a of scanResult.assets.slice(0, 50)) {
    assetContent += `| \`${a.relativePath}\` | \`${a.extension}\` | ${a.sizeBytes} | \`${a.sha256.slice(0, 8)}\` |\n`;
  }
  if (scanResult.assets.length === 0) assetContent += "| - | - | - | - |\n";
  fs.writeFileSync(path.join(dotHypertaks, "ASSET-INDEX.md"), assetContent, "utf8");
  written.push(".hypertaks/ASSET-INDEX.md");

  // 6. Diagrams
  const sysDiagram = `flowchart TD\n    Repo["${identity.display_name}"] --> Modules["Modules (${totalFiles} files)"]\n    Modules --> Symbols["Symbols (${totalSymbols} detected)"]\n`;
  fs.writeFileSync(path.join(diagramsDir, "system-overview.mmd"), sysDiagram, "utf8");
  written.push(".hypertaks/diagrams/system-overview.mmd");

  // 7. Detailed docs in architecture/
  fs.writeFileSync(
    path.join(archDir, "SYSTEM.md"),
    `# System Architecture Detail\n\nFramework: ${frameworksStr}\nScanned: ${now}\n`,
    "utf8",
  );
  written.push(".hypertaks/architecture/SYSTEM.md");

  return written;
}
</file>

<file path="runtime/repository-intelligence/context-enricher.ts">
import * as fs from "node:fs";
import * as path from "node:path";
import { RepositoryScanResult } from "./scanner";
import { RepoIdentity } from "../repo-identity";
import {
  PROJECT_OPERATING_CONTEXT_FILES,
  safeContextGitState,
  ContextGitState,
  resolveWithinApprovedRoot,
  atomicWriteText,
} from "../founder-brain";

export interface ContextEnrichmentResult {
  readonly repoId: string;
  readonly projectDir: string;
  readonly writtenFiles: readonly string[];
  readonly preservedFiles: readonly string[];
}

/**
 * Extracts sections from an existing context document to preserve user-authored
 * edits and historical decisions across rescans.
 */
export function extractExistingSections(existingContent: string): Map<string, string> {
  const sections = new Map<string, string>();
  const parts = existingContent.split(/\n(?=## )/);
  for (const part of parts) {
    const trimmed = part.trim();
    if (trimmed.startsWith("## ")) {
      const newlineIdx = trimmed.indexOf("\n");
      if (newlineIdx !== -1) {
        const heading = trimmed.slice(3, newlineIdx).trim();
        const body = trimmed.slice(newlineIdx + 1).trim();
        if (heading.length > 0) {
          sections.set(heading, body);
        }
      }
    }
  }
  return sections;
}

interface TargetRepoMeta {
  readonly description: string | null;
  readonly license: string | null;
  readonly readmeSnippet: string | null;
  readonly topLevelDirs: readonly { readonly name: string; readonly fileCount: number }[];
  readonly detectedLinters: readonly string[];
}

function extractTargetRepoMeta(canonicalRoot: string, scan: RepositoryScanResult): TargetRepoMeta {
  let description: string | null = null;
  let license: string | null = null;

  // 1. package.json
  const pkgPath = path.join(canonicalRoot, "package.json");
  if (fs.existsSync(pkgPath)) {
    try {
      const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
      if (typeof pkg.description === "string" && pkg.description.trim()) {
        description = pkg.description.trim();
      }
      if (typeof pkg.license === "string" && pkg.license.trim()) {
        license = pkg.license.trim();
      }
    } catch {}
  }

  // 2. README snippet
  let readmeSnippet: string | null = null;
  for (const name of ["README.md", "readme.md", "README"]) {
    const p = path.join(canonicalRoot, name);
    if (fs.existsSync(p)) {
      try {
        const text = fs.readFileSync(p, "utf8");
        const lines = text
          .split("\n")
          .map((l) => l.trim())
          .filter((l) => l.length > 0 && !l.startsWith("#"));
        if (lines.length > 0) {
          readmeSnippet = lines.slice(0, 3).join(" ").trim();
        }
      } catch {}
      break;
    }
  }

  // 3. LICENSE file
  if (!license) {
    for (const name of ["LICENSE", "LICENSE.md", "LICENSE.txt"]) {
      const p = path.join(canonicalRoot, name);
      if (fs.existsSync(p)) {
        try {
          const firstLine = fs.readFileSync(p, "utf8").split("\n")[0]?.trim();
          if (firstLine) license = firstLine;
        } catch {}
        break;
      }
    }
  }

  // 4. Top-level directories
  const dirCounts = new Map<string, number>();
  for (const f of scan.files) {
    const seg = f.relativePath.split("/")[0];
    if (seg && seg !== ".hypertaks") {
      dirCounts.set(seg, (dirCounts.get(seg) ?? 0) + 1);
    }
  }
  const topLevelDirs = Array.from(dirCounts.entries()).map(([name, fileCount]) => ({ name, fileCount }));

  // 5. Linters and tooling
  const detectedLinters: string[] = [];
  if (fs.existsSync(path.join(canonicalRoot, "tsconfig.json"))) detectedLinters.push("TypeScript");
  if (
    fs.existsSync(path.join(canonicalRoot, ".eslintrc.json")) ||
    fs.existsSync(path.join(canonicalRoot, ".eslintrc.js")) ||
    fs.existsSync(path.join(canonicalRoot, "eslint.config.js")) ||
    fs.existsSync(path.join(canonicalRoot, "eslint.config.mjs"))
  ) {
    detectedLinters.push("ESLint");
  }
  if (
    fs.existsSync(path.join(canonicalRoot, ".prettierrc")) ||
    fs.existsSync(path.join(canonicalRoot, ".prettierrc.json"))
  ) {
    detectedLinters.push("Prettier");
  }
  if (fs.existsSync(path.join(canonicalRoot, "biome.json"))) detectedLinters.push("Biome");
  if (
    fs.existsSync(path.join(canonicalRoot, "ruff.toml")) ||
    fs.existsSync(path.join(canonicalRoot, ".ruff.toml"))
  ) {
    detectedLinters.push("Ruff");
  }

  return {
    description,
    license,
    readmeSnippet,
    topLevelDirs,
    detectedLinters,
  };
}

/**
 * Enriches and writes the 13 canonical Project Operating Context living documents
 * inside .hypertaks/projects/<repoId>/ using static screening evidence.
 */
export function enrichProjectOperatingContext(
  canonicalRoot: string,
  identity: RepoIdentity,
  scanResult: RepositoryScanResult,
  options?: {
    readonly agentName?: string;
    readonly gitState?: ContextGitState;
  },
): ContextEnrichmentResult {
  const repoId = identity.repo_id;
  const projectDir = resolveWithinApprovedRoot(canonicalRoot, path.join(".hypertaks", "projects", repoId), true);
  if (!fs.existsSync(projectDir)) {
    fs.mkdirSync(projectDir, { recursive: true });
  }

  const agentName = options?.agentName ?? "Hypertaks-Founder";
  const gitState = options?.gitState ?? safeContextGitState(canonicalRoot);
  const now = new Date().toISOString();

  const writtenFiles: string[] = [];
  const preservedFiles: string[] = [];

  for (const filename of PROJECT_OPERATING_CONTEXT_FILES) {
    const filePath = resolveWithinApprovedRoot(canonicalRoot, path.join(".hypertaks", "projects", repoId, filename), true);
    const relPath = `.hypertaks/projects/${repoId}/${filename}`;

    let existingContent: string | null = null;
    let existingSections = new Map<string, string>();
    let docTimestamp = now;
    if (fs.existsSync(filePath)) {
      try {
        existingContent = fs.readFileSync(filePath, "utf8");
        existingSections = extractExistingSections(existingContent);
        const existingTimestampMatch = existingContent.match(/timestamp:\s*([^\n]+)/);
        if (existingTimestampMatch && existingTimestampMatch[1]) {
          docTimestamp = existingTimestampMatch[1].trim();
        }
      } catch {
        existingContent = null;
      }
    }

    if (existingContent && !existingContent.trim().startsWith("---")) {
      preservedFiles.push(relPath);
      continue;
    }

    const generatedContent = buildDocumentContent(
      filename,
      identity,
      scanResult,
      agentName,
      gitState,
      docTimestamp,
      existingSections,
      canonicalRoot,
    );

    if (existingContent === generatedContent) {
      preservedFiles.push(relPath);
      continue;
    }

    atomicWriteText(canonicalRoot, relPath, generatedContent);
    writtenFiles.push(relPath);
  }

  return {
    repoId,
    projectDir,
    writtenFiles,
    preservedFiles,
  };
}

function renderFrontmatter(
  title: string,
  repoId: string,
  agentName: string,
  gitState: ContextGitState,
  timestamp: string,
  hasUnknowns: boolean,
): string {
  const lifecycle = hasUnknowns ? "PARTIALLY_VERIFIED" : "EVIDENCE_VERIFIED";
  return `---
id: ${title}
version: 1.0.0
timestamp: ${timestamp}
evidence_class: T4_EVIDENCE
provenance:
  agent_id: ${agentName}
  source_file: .hypertaks/projects/${repoId}/${title}.ctx.md
  contract_id: HT-${repoId}
source_git_state:
  commit_sha: ${gitState.commit}
  branch: ${gitState.branch}
  clean_tree: ${gitState.clean}
authority: 4
freshness: FRESH
status: ACTIVE
lifecycle_state: ${lifecycle}
verification: ${lifecycle}
---
`;
}

export function buildDocumentContent(
  filename: string,
  identity: RepoIdentity,
  scanResult: RepositoryScanResult,
  agentName: string,
  gitState: ContextGitState,
  timestamp: string,
  existingSections: Map<string, string>,
  canonicalRoot?: string,
): string {
  const root = canonicalRoot ?? scanResult.root;
  const meta = extractTargetRepoMeta(root, scanResult);
  const title = filename.replace(".ctx.md", "");

  let body = "";
  switch (filename) {
    case "Vision.ctx.md":
      body = buildVisionDoc(identity, scanResult, meta, existingSections);
      break;
    case "Requirements.ctx.md":
      body = buildRequirementsDoc(identity, scanResult, meta, existingSections);
      break;
    case "U-Experience.ctx.md":
      body = buildUserExperienceDoc(identity, scanResult, meta, existingSections);
      break;
    case "architecture.ctx.md":
      body = buildArchitectureDoc(identity, scanResult, meta, existingSections);
      break;
    case "law.ctx.md":
      body = buildLawDoc(identity, scanResult, meta, existingSections);
      break;
    case "database.ctx.md":
      body = buildDatabaseDoc(identity, scanResult, meta, existingSections);
      break;
    case "design.ctx.md":
      body = buildDesignDoc(identity, scanResult, meta, existingSections);
      break;
    case "api.ctx.md":
      body = buildApiDoc(identity, scanResult, meta, existingSections);
      break;
    case "coding-rules.ctx.md":
      body = buildCodingRulesDoc(identity, scanResult, meta, existingSections);
      break;
    case "roadmap.ctx.md":
      body = buildRoadmapDoc(identity, scanResult, meta, existingSections);
      break;
    case "preference.ctx.md":
      body = buildPreferenceDoc(identity, scanResult, meta, existingSections);
      break;
    case "prompt-build-continunity-prompt.ctx.md":
      body = buildContinuityDoc(identity, scanResult, gitState, existingSections);
      break;
    case "security.ctx.md":
      body = buildSecurityDoc(identity, scanResult, meta, existingSections);
      break;
    default:
      body = `# ${title} - Project Operating Context\n\nLiving context document for ${title}.\n`;
  }

  const hasUnknowns = body.includes("UNKNOWN (requires");
  const frontmatter = renderFrontmatter(title, identity.repo_id, agentName, gitState, timestamp, hasUnknowns);
  return frontmatter + body;
}

