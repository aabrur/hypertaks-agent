case_ids = old_keys + [f"EV-{i}" for i in range(50, 89)]
ordered = {cid: new_results[cid] for cid in case_ids}

pass_count = sum(1 for r in ordered.values() if r["verdict"] == "PASS")
non_pass = len(ordered) - pass_count
