    sourceId: "spy",
    categories: ["binary_intelligence"],
    discover: async () => {
      queried.push("spy");
      return [];
    },
  };
  const irrelevant = {
    sourceId: "irrelevant",
    categories: ["cooking", "gardening"],
    discover: async () => {
      queried.push("irrelevant");
      return [];
    },
  };
