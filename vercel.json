{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "buildCommand": "npm run build:runtime",
  "outputDirectory": ".build/runtime",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "{skills/**,assets/Hypertask.svg}"
    }
  }
}
